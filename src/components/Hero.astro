---
import { profile } from '../data/profile';

interface Props {
  lang: 'en' | 'zh';
}
const { lang } = Astro.props;
---

<section class="hero">
  <div class="container hero-inner">
    <div class="hero-content">
      <h1 class="hero-name">{profile.name[lang]}</h1>
      <p class="hero-role">{profile.role[lang]}</p>
      <p class="hero-bio">{profile.bio[lang].short}</p>
      <p class="hero-philosophy"><em>"{profile.philosophy}"</em></p>
      <div class="hero-actions">
        <a href="#research" class="btn btn-primary">{lang === 'en' ? 'View Research' : '查看研究'}</a>
        <a href="/cv/cv_en.pdf" class="btn btn-secondary" target="_blank">{lang === 'en' ? 'Download CV' : '下载简历'}</a>
      </div>
      <div class="hero-links">
        <a href={`mailto:${profile.email}`} title="Email">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
        </a>
        <a href={profile.scholar} target="_blank" title="Google Scholar">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M12 24a7 7 0 1 1 0-14 7 7 0 0 1 0 14zm0-3a4 4 0 1 0 0-8 4 4 0 0 0 0 8zM1 10l11-8 11 8H1z"/></svg>
        </a>
        <a href={profile.github} target="_blank" title="GitHub">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.3 3.44 9.8 8.2 11.39.6.11.82-.26.82-.58v-2.03c-3.34.73-4.04-1.61-4.04-1.61-.55-1.39-1.34-1.76-1.34-1.76-1.09-.75.08-.73.08-.73 1.2.08 1.84 1.24 1.84 1.24 1.07 1.84 2.81 1.31 3.5 1 .11-.78.42-1.31.76-1.61-2.67-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.13-.3-.54-1.52.12-3.18 0 0 1-.32 3.3 1.23a11.5 11.5 0 0 1 6.02 0c2.28-1.55 3.29-1.23 3.29-1.23.66 1.66.25 2.88.12 3.18.77.84 1.24 1.91 1.24 3.22 0 4.61-2.81 5.63-5.48 5.93.43.37.81 1.1.81 2.22v3.29c0 .32.22.7.82.58A12 12 0 0 0 12 0z"/></svg>
        </a>
        <a href={profile.huggingface} target="_blank" title="Hugging Face">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 13.5c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5zm4 0c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5zm2.5-4c0 .28-.22.5-.5.5H8c-.28 0-.5-.22-.5-.5s.22-.5.5-.5h8c.28 0 .5.22.5.5z"/></svg>
        </a>
        <a href={profile.orcid} target="_blank" title="ORCID">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.37 0 0 5.37 0 12s5.37 12 12 12 12-5.37 12-12S18.63 0 12 0zM8.5 6.5c.55 0 1 .45 1 1s-.45 1-1 1-1-.45-1-1 .45-1 1-1zM8 9.5h1v7H8v-7zm3 0h2.7c2.2 0 3.5 1.5 3.5 3.5s-1.3 3.5-3.5 3.5H11v-7zm1 1v5h1.7c1.6 0 2.5-1 2.5-2.5S15.3 10.5 13.7 10.5H12z"/></svg>
        </a>
      </div>
    </div>
    <div class="hero-portrait">
      <img src="/assets/portrait/portrait.png" alt={`Portrait of ${profile.name.en}`} width="320" height="320" />
    </div>
  </div>
</section>

<style>
  .hero {
    padding: var(--spacing-xl) 0;
    border-bottom: 1px solid var(--soft-sage);
  }
  .hero-inner {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: var(--spacing-lg);
    align-items: center;
  }
  .hero-name {
    font-size: 2.8rem;
    font-weight: 700;
    margin-bottom: var(--spacing-xs);
  }
  .hero-role {
    font-size: 1.1rem;
    color: var(--slate);
    margin-bottom: var(--spacing-sm);
  }
  .hero-bio {
    font-size: 1.05rem;
    max-width: 560px;
    margin-bottom: var(--spacing-xs);
  }
  .hero-philosophy {
    font-size: 0.95rem;
    color: var(--slate);
    margin-bottom: var(--spacing-md);
  }
  .hero-actions {
    display: flex;
    gap: var(--spacing-sm);
    margin-bottom: var(--spacing-md);
  }
  .btn {
    display: inline-block;
    padding: 0.6rem 1.4rem;
    border-radius: 6px;
    font-size: 0.9rem;
    font-weight: 500;
    transition: all 0.2s;
  }
  .btn-primary {
    background: var(--route-blue);
    color: white;
  }
  .btn-primary:hover {
    background: #264a6e;
    color: white;
  }
  .btn-secondary {
    border: 1px solid var(--route-blue);
    color: var(--route-blue);
  }
  .btn-secondary:hover {
    background: var(--route-blue);
    color: white;
  }
  .hero-links {
    display: flex;
    gap: var(--spacing-sm);
  }
  .hero-links a {
    color: var(--slate);
    display: flex;
    align-items: center;
    padding: 0.4rem;
    border-radius: 4px;
    transition: all 0.2s;
  }
  .hero-links a:hover {
    color: var(--route-blue);
    background: rgba(49, 94, 138, 0.08);
  }
  .hero-portrait {
    width: 280px;
    height: 280px;
    border-radius: 50%;
    overflow: hidden;
    border: 3px solid var(--soft-sage);
    flex-shrink: 0;
  }
  .hero-portrait img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  @media (max-width: 768px) {
    .hero-inner {
      grid-template-columns: 1fr;
      text-align: center;
    }
    .hero-portrait {
      width: 200px;
      height: 200px;
      margin: 0 auto var(--spacing-md);
      order: -1;
    }
    .hero-name { font-size: 2rem; }
    .hero-actions { justify-content: center; }
    .hero-links { justify-content: center; }
    .hero-bio { margin: 0 auto var(--spacing-xs); }
  }
</style>
