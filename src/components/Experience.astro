---
import { experiences } from '../data/experience';
import { awards } from '../data/awards';

interface Props {
  lang: 'en' | 'zh';
}
const { lang } = Astro.props;
---

<section id="experience" class="section">
  <div class="container">
    <h2 class="section-title">{lang === 'en' ? 'Experience' : '经历'}</h2>

    <div class="exp-list">
      {experiences.map((exp) => (
        <article class="exp-item">
          <div class="exp-period">
            <span class="exp-date">{exp.periodStart}</span>
            <span class="exp-separator">—</span>
            <span class="exp-date">{exp.periodEnd}</span>
          </div>
          <div class="exp-content">
            <h3 class="exp-title">{exp.title[lang]}</h3>
            <p class="exp-org">{exp.org[lang]}</p>
            <p class="exp-desc">{exp.desc[lang]}</p>
          </div>
        </article>
      ))}
    </div>

    <h3 class="subsection-title awards-title">{lang === 'en' ? 'Selected Awards' : '所获荣誉'}</h3>
    <div class="awards-grid">
      {awards.map((award) => (
        <div class="award-item">
          <span class="award-year">{award.year}</span>
          <span class="award-name">{award.title[lang]}</span>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .exp-list {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
    margin-bottom: var(--spacing-xl);
  }
  .exp-item {
    display: grid;
    grid-template-columns: 180px 1fr;
    gap: var(--spacing-md);
    padding: var(--spacing-md);
    background: white;
    border-radius: 8px;
    border: 1px solid var(--soft-sage);
  }
  .exp-period {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    font-family: var(--font-mono);
    color: var(--slate);
    text-align: center;
  }
  .exp-date {
    font-size: 1.05rem;
    font-weight: 500;
    color: var(--ink);
    letter-spacing: 0.01em;
  }
  .exp-separator {
    font-size: 0.8rem;
    color: var(--soft-sage);
    line-height: 1.8;
  }
  .exp-title {
    font-family: var(--font-body);
    font-size: 1.05rem;
    font-weight: 600;
    margin-bottom: 0.2rem;
  }
  .exp-org {
    font-size: 0.9rem;
    color: var(--route-blue);
    font-weight: 500;
    margin-bottom: 0.5rem;
  }
  .exp-desc {
    font-size: 0.88rem;
    color: var(--slate);
    line-height: 1.6;
  }
  .awards-title {
    font-size: 1.3rem;
    margin-bottom: var(--spacing-md);
  }
  .awards-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.75rem;
  }
  .award-item {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    font-size: 0.88rem;
  }
  .award-year {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--slate);
    min-width: 60px;
  }
  .award-name {
    color: var(--ink);
  }
  @media (max-width: 768px) {
    .exp-item {
      grid-template-columns: 1fr;
      gap: 0.5rem;
    }
    .awards-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
